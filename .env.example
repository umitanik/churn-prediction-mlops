# Copy this file to .env and fill in real values. .env is git-ignored.

# PostgreSQL (used by docker compose and to build DATABASE_URL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=churn_db
# Host port the database is published on (containers always use 5432)
POSTGRES_HOST_PORT=5433

# Required by every API endpoint except /health. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string
